# Copy to .env for local development, and set the same names in Netlify's environment variables.
# MongoDB Atlas connection string. Allow 0.0.0.0/0 under Network Access so Netlify can reach it.
MONGODB_URI=
# Database name.
MONGODB_DB=ghostlight
# At least 32 random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
